#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

# load frobulator once

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# keep the sudo user home

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	# local copy and download

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# fetch the latest release

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	# keep only a newer release

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	# drop the download

	rm -f "${frobulator_download}"

	# stop without frobulator

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	# load the library

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-directory)
			directory="${2}"

			shift
		;;

		-a|--all)
			option="all"
		;;

		-i|--industrial)
			option="industrial"
		;;

		-g|--graphic)
			option="graphic"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} [EXTENSION] | [OPTION] [PARAMETER]"
			echo
			echo -e "Options:"
			echo
			echo -e "Note:               Without an option, every step runs."
			echo
			echo -e "-directory          Specify [d]irectory to load models from."
			echo
			echo -e "-a, --all           Update [a]ll website framework and content."
			echo
			echo -e "-i, --industrial    Update [i]ndustrial content."
			echo
			echo -e "-g, --graphic       Update [g]raphic content."
			echo
			echo -e "-h, --help          Show [h]elp and usage information."
			echo
			echo -e "'${script}'         [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} [EXTENSION] | [OPTION] [PARAMETER]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# clear ────────────────────────────────────────────────────────────────────────

frobulator.clear

# variables ────────────────────────────────────────────────────────────────────

# models folder for the tools

export directory="${directory}"

# tools folder

directory_tools="${PWD}"/tools

# defaults ─────────────────────────────────────────────────────────────────────

# without an option every step runs

option="${option:-all}"

# functions ────────────────────────────────────────────────────────────────────

upload () {

	# use to commit and push everything

	message="${1}"

	git add --all

	git commit	\
		--all	\
		--message="${message}"

	git push > "${sink}" 2>&1

	echo

}

option () {

	# use to run the listed tools

	for name_tool in "${list[@]}"
	do
		bash "${directory_tools}/${name_tool}"
	done

	# publish the results

	frobulator.fwd "Updating..."

	upload "Models update"

	list=()

}

# requirements ─────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# every tool

if [[ "${option}" = "all" ]]
then
	list+=(
		nathaneltitane-social
		nathaneltitane-drawer
		nathaneltitane-industrial
		nathaneltitane-graphic
	)
fi

# one tool per option

if [[ "${option}" = "drawer" ]]
then
	list+=(
		nathaneltitane-drawer
	)
fi

if [[ "${option}" = "industrial" ]]
then
	list+=(
		nathaneltitane-industrial
	)
fi

if [[ "${option}" = "graphic" ]]
then
	list+=(
		nathaneltitane-graphic
	)
fi

# run and publish

option ${list[@]}

list=()

frobulator.scs "Update" "[ Done ]"
