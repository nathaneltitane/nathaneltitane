#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

# load frobulator once

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# keep the sudo user home

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	# local copy and download

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# fetch the latest release

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	# keep only a newer release

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	# drop the download

	rm -f "${frobulator_download}"

	# stop without frobulator

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	# load the library

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# graphic folder

directory_graphic="${PWD}"/graphic

# home page, site address and section

file_index="${PWD}/index.html"
url_site="https://nathaneltitane.com"
id_section="graphic"
name_section="Graphic Design"

# home page block markers

marker_begin="<!-- ${id_section}-begin -->"
marker_end="<!-- ${id_section}-end -->"

# home page entries

list_items=()
list_schema=()

declare -A list_seen

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

html_escape () {

	# use to make text safe in html and json

	local text="${1}"

	text="${text//&/&amp;}"
	text="${text//</&lt;}"
	text="${text//>/&gt;}"
	text="${text//\"/&quot;}"
	text="${text//\\/&#92;}"

	text_escaped="${text}"

}

project_add () {

	# use to list one project on the home page

	local name_project="${1}"
	local keywords_project="${2}"
	local path_project="${3}"
	local name_escaped
	local keywords_escaped
	local text_item
	local text_keywords
	local position_project

	html_escape "${name_project}"

	name_escaped="${text_escaped}"

	html_escape "${keywords_project}"

	keywords_escaped="${text_escaped}"

	position_project=$(( ${#list_items[@]} + 1 ))

	# item text and schema keywords

	text_item="${name_escaped}"

	if [ -n "${keywords_escaped}" ]
	then
		text_item="${name_escaped} - ${keywords_escaped}"
		text_keywords=", \"keywords\": \"${keywords_escaped}\""
	fi

	list_items+=( "					<li><a href=\"/${path_project}\">${text_item}</a></li>" )
	list_schema+=( "					{ \"@type\": \"ListItem\", \"position\": ${position_project}, \"item\": { \"@type\": \"CreativeWork\", \"name\": \"${name_escaped}\", \"image\": \"${url_site}/${path_project}\"${text_keywords}, \"creator\": { \"@id\": \"${url_site}/#person\" } } }" )

}

index_write () {

	# use to replace the section block on the home page

	local text_index
	local text_before
	local text_after
	local text_items
	local text_schema
	local item_schema

	text_index="$(< "${file_index}")"

	# stop when the markers are missing

	if [[ "${text_index}" != *"${marker_begin}"*"${marker_end}"* ]]
	then
		frobulator.err "Markers missing" "[ ${file_index} // ${marker_begin} ]"

		return
	fi

	text_before="${text_index%%"${marker_begin}"*}"
	text_after="${text_index#*"${marker_end}"}"

	printf -v text_items '%s\n' "${list_items[@]}"

	# schema items joined by commas

	for item_schema in "${list_schema[@]}"
	do
		if [ -n "${text_schema}" ]
		then
			text_schema+=$',\n'
		fi

		text_schema+="${item_schema}"
	done

	cat > "${file_index}" << INDEX-SECTION
${text_before}${marker_begin}

			<section id="${id_section}">

				<h2>${name_section}</h2>

				<ul>
${text_items}				</ul>

			</section>

			<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "ItemList",
				"@id": "${url_site}/#${id_section}",
				"name": "${name_section}",
				"numberOfItems": ${#list_items[@]},
				"itemListElement": [
${text_schema}
				]
			}
			</script>

			${marker_end}${text_after}
INDEX-SECTION

	frobulator.inf "Home page" "[ ${name_section} // ${#list_items[@]} projects ]"

}

# report progress

frobulator.inf "Generating graphic content entries"

frobulator.fwd "Writing..."

# page header

cat << 'INDEX-HEADER' -> "graphic/index.html"
		<script>

			$(function(){

				$.get("/resources/modules/anchors.html", function (data) {

					$("#anchors").append(data);

				});

				}
			);

		</script>

		<!-- BEGIN INDEX -->

INDEX-HEADER

# file types

list_extensions=(
	png
)

# entry counter

count_entries=1

for extension in ${list_extensions[@]}
do
	# every file of this type

	list_paths_content=( $(find ${directory_graphic} -type f -iname "*.${extension}" | sort) )

	# split on new lines

	IFS=$'\n'

	for path_content in ${list_paths_content[@]}
	do
		# path below the site root

		path_content=$(echo "${path_content}" | cut -d '/' -f6-)

		# image file name

		file_content="${path_content##*/}"

		# name without extension

		name_content="${file_content%.*}"

		# image folder

		directory_content="${path_content%/*}"

		# first image of each project on the home page

		if [ -z "${list_seen[${directory_content}]}" ]
		then
			list_seen[${directory_content}]=1

			# project name from its folder

			name_folder="${directory_content##*/}"

			IFS=' ' read -r -a list_words <<< "${name_folder//-/ }"

			printf -v name_project '%s ' "${list_words[@]^}"

			project_add "${name_project% }" "" "${path_content}"
		fi

		# keep first container visible

		if [ "${count_entries}" -gt 1 ]
		then
			class_container="container"
		else
			class_container="container"
		fi

# content containers

cat << CONTENT-CONTAINER ->> "graphic/index.html"
		<!-- BEGIN CONTAINER -->

		<div class='${class_container}'>

			<div class="flex flex-column">

				<div class='flex-cell flex-cell-center'>

					<a href="/${path_content}">

						<img src="/${path_content}"/>

					</a>

				</div>

			</div>

		</div>

		<!-- END CONTAINER -->

CONTENT-CONTAINER

	# count the entry

	(( count_entries ++ ))

	done

	# default splitting

	IFS=''

done

# write the home page section

index_write

# report the result

frobulator.inf "Entries" "[ ${count_entries} ]"

frobulator.cpt "Complete" "[ Graphic ]"
