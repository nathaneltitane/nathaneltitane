#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_industrial="${PWD}"/industrial

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

frobulator.inf "Generating industrial content entries"

frobulator.fwd "Writing..."

# generate header

cat << 'INDEX-HEADER' -> "industrial/index.html"
		<script>

			$(function(){

				$.get("/modules/anchors.html", function (data) {

					$("#anchors").append(data);

				});

				}
			);

		</script>

		<!-- BEGIN INDEX -->

INDEX-HEADER

# values

list_extensions=(
	jpg
	svg
)

count_entries=1

for extension in ${list_extensions[@]}
do
	list_paths_content=( $(find ${directory_industrial} -type f -iname "*.${extension}" | sort) )

	# set IFS

	IFS=$'\n'

	for path_content in ${list_paths_content[@]}
	do
		path_content=$(echo "${path_content}" | cut -d '/' -f6-)

		# get content file name from path

		file_content="${path_content##*/}"

		# strip extension from content file name

		name_content="${file_content%.*}"

		# use content directory as root

		directory_content="${path_content%/*}"

		# define content title file location

		title_content=$(cat "${directory_content}"/title)

		# keep first container visible

		if [ "${count_entries}" -gt 1 ]
		then
			class_container="container"
		else
			class_container="container"
		fi

# generate content container

cat << CONTENT-CONTAINER ->> "industrial/index.html"
		<!-- BEGIN CONTAINER -->

		<div class='${class_container}'>

			<div class="flex flex-column">

CONTENT-CONTAINER

cat << CONTENT-TITLE ->> "industrial/index.html"

				<div class="flex-cell flex-cell-center flex-cell-stretch">

					<div class="button">${title_content}</div>

				</div>

				<div class='flex-cell flex-cell-center'>

					<a href="/${path_content}">

						<img src="/${path_content}"/>

					</a>

				</div>

CONTENT-TITLE

cat << CONTENT-CONTAINER ->> "industrial/index.html"
			</div>

		</div>

		<!-- END CONTAINER -->

CONTENT-CONTAINER

	(( count_entries ++ ))

	done

	# reset IFS

	IFS=''

done

frobulator.inf "Entries" "[ ${count_entries} ]"

frobulator.cpt "Complete" "[ Industrial ]"
